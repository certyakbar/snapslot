{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapslot.local/schemas/sir-transport.json",
  "title": "SnapSlot SIR Transport Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "repo_anchor",
    "payload_sha256",
    "payload"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "sir-transport.v1"
    },
    "repo_anchor": {
      "$ref": "https://snapslot.local/schemas/sir-base.json#/$defs/repo_anchor"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "string",
      "minLength": 2
    },
    "context_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens"],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "tokenizer": {
          "type": "string",
          "const": "gpt-tokenizer"
        }
      }
    }
  }
}
