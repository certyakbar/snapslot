{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapslot.local/schemas/sir-block.json",
  "title": "SnapSlot SIR BLOCK Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_type",
    "repo_anchor",
    "intent",
    "compiler_audit",
    "blocks",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "sir.v1"
    },
    "result_type": {
      "type": "string",
      "const": "BLOCK"
    },
    "repo_anchor": {
      "$ref": "https://snapslot.local/schemas/sir-base.json#/$defs/repo_anchor"
    },
    "intent": {
      "$ref": "https://snapslot.local/schemas/sir-base.json#/$defs/intent"
    },
    "compiler_audit": {
      "$ref": "https://snapslot.local/schemas/sir-base.json#/$defs/compiler_audit"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "$ref": "https://snapslot.local/schemas/sir-base.json#/$defs/block_code"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtype", "partial_context"],
      "properties": {
        "subtype": {
          "type": "string",
          "const": "ESCALATE_TO_GOVERNOR_WITH_PARTIAL_CONTEXT"
        },
        "partial_context": {
          "$ref": "https://snapslot.local/schemas/sir-base.json#/$defs/partial_context"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "compiler_audit": {
            "type": "object",
            "properties": {
              "block_code": {
                "const": "CONTEXT_BUDGET_EXCEEDED"
              }
            },
            "required": ["block_code"]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "escalation": true
        },
        "required": ["escalation"]
      }
    }
  ]
}
