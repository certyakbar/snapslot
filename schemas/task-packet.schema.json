{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SnapSlot Task Packet",
  "description": "Machine-readable canonical schema for SnapSlot task packets. Source of truth: docs/SNAPSLOT_TASK_PACKET_SCHEMA.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_name",
    "phase",
    "workflow",
    "risk_level",
    "actor_surface",
    "allowed_files",
    "forbidden_files",
    "required_behavior",
    "forbidden_behavior",
    "validation_commands",
    "stop_rule",
    "return_format"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-\\S+$"
    },
    "task_name": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "Phase N/A",
        "Phase 0",
        "Phase 1",
        "Phase 2",
        "Phase 3",
        "Phase 4",
        "Phase 5",
        "Phase 6",
        "Phase 7",
        "Phase 8",
        "Phase 9",
        "Phase 10",
        "Phase 11",
        "Phase 12"
      ]
    },
    "workflow": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "actor_surface": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "PLATFORM_OWNER",
          "BUSINESS_ADMIN",
          "CUSTOMER",
          "INTERNAL"
        ]
      }
    },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_behavior": {
      "type": "string",
      "minLength": 1
    },
    "forbidden_behavior": {
      "type": "string",
      "minLength": 1
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_rule": {
      "type": "string",
      "minLength": 1
    },
    "return_format": {
      "type": "string",
      "minLength": 1
    },
    "known_contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[CD]-\\d+$"
      }
    },
    "docs_may_change": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "required": [
            "value",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "boolean",
              "const": true
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "ledger_update_required": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "required": [
            "value",
            "detail"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "boolean",
              "const": true
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "phase": {
        "const": "Phase N/A"
      }
    }
  },
  "then": {
    "properties": {
      "workflow": {
        "const": "N/A"
      }
    }
  },
  "else": {
    "properties": {
      "workflow": {
        "pattern": "^Workflow [A-L](\\b.*)?$"
      }
    }
  }
}
